# Create a Resend API key at https://resend.com/api-keys.
# Never commit a real API key to this file.
RESEND_API_KEY=re_your_resend_api_key

# Verify sobol.ps in Resend before using this sender.
CONTACT_FROM_EMAIL=Sobol Website <website@example.com>
CONTACT_TO_EMAIL=contact@example.com

# Public Sanity project configuration.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only Viewer token used for authenticated draft preview.
SANITY_API_READ_TOKEN=your_sanity_viewer_token

# Secret configured on the signed Sanity webhook.
SANITY_REVALIDATE_SECRET=your_long_random_webhook_secret

# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.sobol.ps
